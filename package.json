{
  "name": "dslm",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev:ios": "xcodebuild -workspace ios/dslm.xcworkspace -configuration Debug -scheme dslm -destination 'id=00008140-001878900C82801C' -allowProvisioningUpdates -allowProvisioningDeviceRegistration && xcrun devicectl device install app --device 00008140-001878900C82801C ~/Library/Developer/Xcode/DerivedData/dslm-gajftdasexmjaqgrxdzrzjtwpopg/Build/Products/Debug-iphoneos/dslm.app",
    "dev:android": "expo run:android --device",
    "web": "expo start --web",
    "server:dev": "npm --prefix server run dev",
    "dev:all": "concurrently \"npm run start\" \"npm run server:dev\"",
    "lint": "expo lint",
    "dev": "node scripts/dev.mjs",
    "dev:tunnel": "node scripts/dev.mjs --ngrok --tunnel",
    "demo:server": "./scripts/demo-server.sh",
    "demo:setup": "./scripts/setup-demo-devices.sh",
    "build:demo": "eas build --profile demo --platform all --local",
    "build:demo:ios": "eas build --profile demo --platform ios --local",
    "build:demo:android": "eas build --profile demo --platform android --local"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/elements": "^2.6.4",
    "@react-navigation/native": "^7.1.17",
    "expo": "~54.0.12",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.13",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-reanimated": "~4.1.2",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.1",
    "react-native-worklets": "0.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~10.0.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
